{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prod-qoodish-web",
  "account_id": "9671c836ad132f87d892b12ccd1809e0",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [{ "pattern": "qoodish.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "prod-qoodish-web"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    },
    "logs": {
      "enabled": true
    },
    "issues": {
      "enabled": true
    }
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "prod-qoodish-web-incremental-cache"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      },
      {
        "name": "NEXT_TAG_CACHE_DO_SHARDED",
        "class_name": "DOShardedTagCache"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["DOShardedTagCache"]
    }
  ],
  // Cloudflare Images is paid for and shared, so one account allocating
  // uploads in a loop is held to a burst and a per-minute ceiling.
  "ratelimits": [
    {
      "name": "IMAGE_UPLOAD_BURST_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 10 }
    },
    {
      "name": "IMAGE_UPLOAD_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS_EVENTS",
      "dataset": "prod_qoodish_web_events"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "API_ENDPOINT": "https://api.qoodish.com"
  },
  "env": {
    "dev": {
      "name": "dev-qoodish-web",
      // Routes and URL toggles are inherited from the top level, so dev has to
      // restate them or it would claim qoodish.com and lose the workers.dev URL
      // it is reached through.
      "routes": [],
      "workers_dev": true,
      "preview_urls": true,
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "dev-qoodish-web"
        }
      ],
      "r2_buckets": [
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "dev-qoodish-web-incremental-cache"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "NEXT_CACHE_DO_QUEUE",
            "class_name": "DOQueueHandler"
          },
          {
            "name": "NEXT_TAG_CACHE_DO_SHARDED",
            "class_name": "DOShardedTagCache"
          }
        ]
      },
      "migrations": [],
      "exports": {
        "DOQueueHandler": { "type": "durable-object", "storage": "sqlite" },
        "DOShardedTagCache": { "type": "durable-object", "storage": "sqlite" }
      },
      "ratelimits": [
        {
          "name": "IMAGE_UPLOAD_BURST_LIMIT",
          "namespace_id": "2001",
          "simple": { "limit": 10, "period": 10 }
        },
        {
          "name": "IMAGE_UPLOAD_LIMIT",
          "namespace_id": "2002",
          "simple": { "limit": 30, "period": 60 }
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "ANALYTICS_EVENTS",
          "dataset": "dev_qoodish_web_events"
        }
      ],
      "vars": {
        "APP_ENV": "development",
        "API_ENDPOINT": "https://api-dev.qoodish.com"
      },
      "previews": {
        "services": [
          {
            "binding": "WORKER_SELF_REFERENCE",
            "service": "dev-qoodish-web"
          }
        ],
        "r2_buckets": [
          {
            "binding": "NEXT_INC_CACHE_R2_BUCKET",
            "bucket_name": "dev-qoodish-web-incremental-cache"
          }
        ],
        "durable_objects": {
          "bindings": [
            {
              "name": "NEXT_CACHE_DO_QUEUE",
              "class_name": "DOQueueHandler"
            },
            {
              "name": "NEXT_TAG_CACHE_DO_SHARDED",
              "class_name": "DOShardedTagCache"
            }
          ]
        },
        "ratelimits": [
          {
            "name": "IMAGE_UPLOAD_BURST_LIMIT",
            "namespace_id": "3001",
            "simple": { "limit": 10, "period": 10 }
          },
          {
            "name": "IMAGE_UPLOAD_LIMIT",
            "namespace_id": "3002",
            "simple": { "limit": 30, "period": 60 }
          }
        ],
        "analytics_engine_datasets": [
          {
            "binding": "ANALYTICS_EVENTS",
            "dataset": "dev_qoodish_web_events"
          }
        ],
        "vars": {
          "APP_ENV": "development",
          "API_ENDPOINT": "https://api-dev.qoodish.com"
        }
      }
    }
  }
}
