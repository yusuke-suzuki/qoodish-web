{
  "name": "qoodish-web",
  "version": "4.0.2",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 5000",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-test-module-mocks --test \"src/**/*.test.ts\"",
    "e2e": "playwright test",
    "preview": "opennextjs-cloudflare preview --env dev",
    "cf:build": "opennextjs-cloudflare build",
    "cf:build:dev": "opennextjs-cloudflare build --env dev",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:deploy:dev": "opennextjs-cloudflare deploy --env dev",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@googlemaps/js-api-loader": "^1.16.2",
    "@lexical/link": "0.46.0",
    "@lexical/list": "^0.46.0",
    "@lexical/markdown": "0.46.0",
    "@lexical/react": "^0.46.0",
    "@lexical/rich-text": "^0.46.0",
    "@lexical/selection": "^0.46.0",
    "@lexical/utils": "^0.46.0",
    "@mui/icons-material": "^7.3.4",
    "@mui/lab": "^7.0.1-beta.18",
    "@mui/material": "^7.3.4",
    "@mui/material-nextjs": "^9.3.0",
    "@qoodish/api-contract": "workspace:*",
    "@serwist/window": "^9.2.1",
    "firebase": "^12.4.0",
    "lexical": "^0.46.0",
    "next": "^16.3.3",
    "notistack": "^3.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.62.1",
    "@serwist/next": "^9.2.1",
    "@types/google.maps": "^3.54.6",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "serwist": "^9.2.1",
    "typescript": "^5.2.2",
    "wrangler": "^4.148.0"
  }
}
