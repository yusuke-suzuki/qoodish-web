    "next": "^16.3.3",
    "notistack": "^3.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-server-dom-webpack": "^19.3.0",
    "vinext": "^1.0.1"
  },
