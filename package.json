{
  "name": "qoodish",
  "version": "4.0.2",
  "main": "index.js",
  "repository": "git@github.com:yusuke-suzuki/qoodish-web.git",
  "author": "Yusuke Suzuki",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "next dev --webpack -p 5000",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "biome ci ./src ./e2e playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.ts\"",
    "e2e": "playwright test",
    "preview": "pnpm run cf:build && opennextjs-cloudflare preview",
    "deploy": "pnpm run cf:build && pnpm run cf:deploy",
    "deploy:dev": "pnpm run cf:build:dev && pnpm run cf:deploy:dev",
    "cf:build": "opennextjs-cloudflare build",
    "cf:build:dev": "opennextjs-cloudflare build --env dev",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:deploy:dev": "opennextjs-cloudflare deploy --env dev",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@googlemaps/js-api-loader": "^1.16.2",
    "@lexical/link": "0.46.0",
    "@lexical/list": "^0.46.0",
    "@lexical/markdown": "0.46.0",
    "@lexical/react": "^0.46.0",
    "@lexical/rich-text": "^0.46.0",
    "@lexical/selection": "^0.46.0",
    "@lexical/utils": "^0.46.0",
    "@mui/icons-material": "^7.3.4",
    "@mui/lab": "^7.0.1-beta.18",
    "@mui/material": "^7.3.4",
    "@mui/material-nextjs": "^9.3.0",
    "@serwist/window": "^9.2.1",
    "autosuggest-highlight": "^3.1.1",
    "blueimp-canvas-to-blob": "^3.27.0",
    "blueimp-load-image": "^5.12.0",
    "date-fns": "^2.17.0",
    "firebase": "^12.4.0",
    "html2canvas": "^1.4.1",
    "lexical": "^0.46.0",
    "lodash.debounce": "^4.0.8",
    "lodash.throttle": "^4.1.1",
    "next": "^16.3.3",
    "notistack": "^3.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "swiper": "^11.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.62.1",
    "@serwist/next": "^9.2.1",
    "@types/google.maps": "^3.54.6",
    "@types/lodash.debounce": "^4.0.7",
    "@types/lodash.throttle": "^4.1.7",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "serwist": "^9.2.1",
    "typescript": "^5.2.2",
    "wrangler": "^4.114.0"
  }
}
