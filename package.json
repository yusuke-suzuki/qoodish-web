  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "vite dev --port 5000",
    "preview": "vite preview --port 8787",
    "lint": "biome ci ./src ./e2e ./synthetics/src ./admin/src ./vite playwright.config.ts vite.config.ts cloudflare.config.ts",
    "typecheck": "cf workers types && tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-test-module-mocks --test \"src/**/*.test.ts\"",
    "e2e": "playwright test",
    "cf:build": "vite build",
    "cf:build:dev": "vite build --mode dev",
    "cf:deploy": "vinext-cloudflare deploy",
    "cf:deploy:dev": "vinext-cloudflare deploy --env dev",
    "cf:preview": "cf previews deploy"
  },
  "dependencies": {
